{
  "expo": {
    "name": "내곁의 디데이",
    "slug": "naegyeot-dday",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naegyeot.dday"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B68",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.naegyeot.dday",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "scheme": "naegyeotdday",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1F6B68"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DdayWidget",
              "label": "내곁의 디데이",
              "description": "가까운 디데이를 홈 화면에 보여줘요 (Pro)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "previewImage": "./assets/widget-preview.png"
            },
            {
              "name": "DdayCalendarWidget",
              "label": "내곁의 디데이 달력",
              "description": "이번 달 디데이를 달력으로 보여줘요 (Pro)",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "previewImage": "./assets/widget-calendar-preview.png"
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F5"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withGradleProperties",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ]
  }
}

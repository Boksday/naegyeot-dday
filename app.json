{
  "expo": {
    "name": "내곁의 디데이",
    "slug": "naegyeot-dday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naegyeot.dday"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6B68",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.naegyeot.dday"
    },
    "scheme": "naegyeotdday",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1F6B68"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DdayWidget",
              "label": "내곁의 디데이",
              "description": "가까운 디데이를 홈 화면에 보여줘요",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F5"
        }
      ]
    ]
  }
}

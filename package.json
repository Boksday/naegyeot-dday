    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci",
    "build:android:release": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "build:android:bundle": "expo prebuild --platform android --no-install && cd android && ./gradlew bundleRelease"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }

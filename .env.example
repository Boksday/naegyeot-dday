# 광고(AdMob) 설정. 실제 값은 .env에 넣고 커밋하지 않는다.
# 앱 ID(네이티브 빌드에 들어감). 비우면 구글 공식 테스트 앱 ID를 쓴다.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# 배너 광고 단위 ID(앱 번들에 들어감). 운영 빌드에서 비어 있으면 광고를 띄우지 않는다.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
# 1이면 운영 빌드에서도 테스트 광고를 쓴다(기기에서 광고 연결 확인용, 배포 금지).
EXPO_PUBLIC_ADMOB_USE_TEST_IDS=
